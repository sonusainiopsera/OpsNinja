{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@opsninja/db": ["../../packages/db/src/index.ts"],
      "@opsninja/db/*": ["../../packages/db/src/*"],
      "@opsninja/api-types": ["../../packages/api-types/src/index.ts"],
      "@opsninja/api-types/*": ["../../packages/api-types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.e2e-spec.ts", "test"]
}
