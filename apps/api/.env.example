# ── Database (PgBouncer → PostgreSQL 16) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opsninja
DB_USER=opsninja_app
DB_PASSWORD=changeme
DB_POOL_MAX=20

# Per-request timeouts (milliseconds)
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth (OIDC – full config in future WO) ────────────────────────────────────
JWT_ISSUER=https://your-idp.example.com
JWT_AUDIENCE=opsninja-api

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
