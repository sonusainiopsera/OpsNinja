# HELP dashboard_events_consumed_total Total outbox events consumed by the dashboard aggregator
# TYPE dashboard_events_consumed_total counter
dashboard_events_consumed_total{event_type="ticket.created",outcome="applied"} 1300
dashboard_events_consumed_total{event_type="ticket.updated",outcome="applied"} 900

# HELP dashboard_events_deduplicated_total Total events skipped as duplicates
# TYPE dashboard_events_deduplicated_total counter
dashboard_events_deduplicated_total{event_type="ticket.created"} 18

# HELP dashboard_aggregate_drift Absolute difference between Redis and Postgres counter values
# TYPE dashboard_aggregate_drift gauge
# DRIFT SCENARIO: drift is > 50 across multiple tenant buckets.
# This triggers RealtimeAggregateDriftHigh (max(dashboard_aggregate_drift) > 50 for 2m).
dashboard_aggregate_drift{counter="open_total",tenant_bucket="bucket_0"} 75
dashboard_aggregate_drift{counter="open_total",tenant_bucket="bucket_1"} 120
dashboard_aggregate_drift{counter="breach_count",tenant_bucket="bucket_0"} 8
dashboard_aggregate_drift{counter="open_total",tenant_bucket="other"} 55

# HELP dashboard_publish_interval_lag_ms Milliseconds between scheduled publish interval and actual execution
# TYPE dashboard_publish_interval_lag_ms gauge
dashboard_publish_interval_lag_ms 18

# HELP dashboard_snapshot_source_total Total snapshot aggregates loaded from cache vs database
# TYPE dashboard_snapshot_source_total counter
# ELEVATED database ratio: > 5% of snapshots from Postgres.
# Triggers RealtimeSnapshotSourceDatabaseHigh.
# rate(database[5m]) / (rate(database[5m]) + rate(cache[5m])) = 600/2600 ≈ 23% > 5%
dashboard_snapshot_source_total{source="cache"} 11800
dashboard_snapshot_source_total{source="database"} 600

# HELP dashboard_reconcile_cycles_total Total reconciliation cycles completed
# TYPE dashboard_reconcile_cycles_total counter
dashboard_reconcile_cycles_total{outcome="success"} 490
dashboard_reconcile_cycles_total{outcome="error"} 5

# HELP dashboard_dlq_depth Current DLQ depth for dashboard-aggregates queue
# TYPE dashboard_dlq_depth gauge
# DLQ NON-EMPTY: triggers RealtimeDlqNonEmpty
dashboard_dlq_depth 3

# HELP realtime_connections_active Number of active WebSocket connections on this pod
# TYPE realtime_connections_active gauge
realtime_connections_active{pod="gateway-0"} 420
realtime_connections_active{pod="gateway-1"} 405

# HELP realtime_connection_churn_total Total WebSocket connection close events
# TYPE realtime_connection_churn_total counter
realtime_connection_churn_total{reason="client_close",close_code="1000"} 250

# HELP realtime_frames_delivered_total Total frames delivered to connected clients
# TYPE realtime_frames_delivered_total counter
# Frames are being delivered (no stall) — this fixture tests DRIFT alerts, not staleness
realtime_frames_delivered_total{frame_type="delta"} 52000
realtime_frames_delivered_total{frame_type="snapshot"} 900

# HELP realtime_backfill_frames_total Total backfill frames sent on reconnect
# TYPE realtime_backfill_frames_total counter
realtime_backfill_frames_total 158

# HELP realtime_snapshot_required_total Total times a snapshot frame was required instead of a delta
# TYPE realtime_snapshot_required_total counter
realtime_snapshot_required_total{reason="reconnect"} 12
realtime_snapshot_required_total{reason="first_frame"} 825

# HELP realtime_slow_consumer_drops_total Total frames dropped because the consumer outbound queue was full
# TYPE realtime_slow_consumer_drops_total counter
realtime_slow_consumer_drops_total 2

# HELP realtime_frame_delivery_seconds Latency from frame generation to socket send (seconds)
# TYPE realtime_frame_delivery_seconds histogram
realtime_frame_delivery_seconds_bucket{frame_type="delta",le="0.005"} 45000
realtime_frame_delivery_seconds_bucket{frame_type="delta",le="+Inf"} 52000
realtime_frame_delivery_seconds_sum{frame_type="delta"} 208.0
realtime_frame_delivery_seconds_count{frame_type="delta"} 52000
