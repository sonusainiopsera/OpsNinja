# HELP dashboard_events_consumed_total Total outbox events consumed by the dashboard aggregator
# TYPE dashboard_events_consumed_total counter
# Events ARE being consumed (pipeline is active) but no frames are being delivered —
# this simulates a stalled delta publisher or broken Redis pub/sub path.
dashboard_events_consumed_total{event_type="ticket.created",outcome="applied"} 1250
dashboard_events_consumed_total{event_type="ticket.updated",outcome="applied"} 830

# HELP dashboard_events_deduplicated_total Total events skipped as duplicates
# TYPE dashboard_events_deduplicated_total counter
dashboard_events_deduplicated_total{event_type="ticket.created"} 14

# HELP dashboard_aggregate_drift Absolute difference between Redis and Postgres counter values
# TYPE dashboard_aggregate_drift gauge
dashboard_aggregate_drift{counter="open_total",tenant_bucket="bucket_0"} 0
dashboard_aggregate_drift{counter="open_total",tenant_bucket="bucket_1"} 2

# HELP dashboard_publish_interval_lag_ms Milliseconds between scheduled publish interval and actual execution
# TYPE dashboard_publish_interval_lag_ms gauge
# Elevated lag — publisher is delayed
dashboard_publish_interval_lag_ms 12500

# HELP dashboard_snapshot_source_total Total snapshot aggregates loaded from cache vs database
# TYPE dashboard_snapshot_source_total counter
dashboard_snapshot_source_total{source="cache"} 9800
dashboard_snapshot_source_total{source="database"} 3

# HELP dashboard_reconcile_cycles_total Total reconciliation cycles completed
# TYPE dashboard_reconcile_cycles_total counter
dashboard_reconcile_cycles_total{outcome="success"} 481
dashboard_reconcile_cycles_total{outcome="error"} 0

# HELP dashboard_dlq_depth Current DLQ depth for dashboard-aggregates queue
# TYPE dashboard_dlq_depth gauge
dashboard_dlq_depth 0

# HELP realtime_connections_active Number of active WebSocket connections on this pod
# TYPE realtime_connections_active gauge
realtime_connections_active{pod="gateway-0"} 415
realtime_connections_active{pod="gateway-1"} 392

# HELP realtime_connection_churn_total Total WebSocket connection close events
# TYPE realtime_connection_churn_total counter
realtime_connection_churn_total{reason="client_close",close_code="1000"} 231

# HELP realtime_frames_delivered_total Total frames delivered to connected clients
# TYPE realtime_frames_delivered_total counter
# ZERO frames delivered — the publisher is stalled; this triggers RealtimeNoFramesPublished
# (sum(increase(realtime_frames_delivered_total[1m])) == 0)
realtime_frames_delivered_total{frame_type="delta"} 48000
# Note: these are cumulative counters — the RATE over the last 1m is 0
# because no new frames have been added. The alert expression uses increase([1m]).

# HELP realtime_backfill_frames_total Total backfill frames sent on reconnect
# TYPE realtime_backfill_frames_total counter
realtime_backfill_frames_total 143

# HELP realtime_snapshot_required_total Total times a snapshot frame was required instead of a delta
# TYPE realtime_snapshot_required_total counter
realtime_snapshot_required_total{reason="reconnect"} 8
realtime_snapshot_required_total{reason="first_frame"} 807

# HELP realtime_slow_consumer_drops_total Total frames dropped because the consumer outbound queue was full
# TYPE realtime_slow_consumer_drops_total counter
realtime_slow_consumer_drops_total 0

# HELP realtime_frame_delivery_seconds Latency from frame generation to socket send (seconds)
# TYPE realtime_frame_delivery_seconds histogram
realtime_frame_delivery_seconds_bucket{frame_type="delta",le="0.005"} 42000
realtime_frame_delivery_seconds_bucket{frame_type="delta",le="+Inf"} 48000
realtime_frame_delivery_seconds_sum{frame_type="delta"} 192.0
realtime_frame_delivery_seconds_count{frame_type="delta"} 48000
