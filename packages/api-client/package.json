{
  "name": "@opsninja/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed API client with silent token refresh for OpsNinja web apps",
  "main": "./src/index.browser.ts",
  "exports": {
    ".": "./src/index.browser.ts",
    "./server": "./src/index.server.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.56.0",
    "msw": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.56.0",
    "@vitest/coverage-v8": "^2.0.0",
    "msw": "^2.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
