{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "paths": {
      "@opsninja/api-client": ["./packages/api-client/src/index.browser.ts"],
      "@opsninja/api-client/browser": ["./packages/api-client/src/index.browser.ts"],
      "@opsninja/api-client/server": ["./packages/api-client/src/index.server.ts"],
      "@opsninja/db": ["./packages/db/src/index.ts"],
      "@opsninja/db/*": ["./packages/db/src/*"],
      "@opsninja/webhooks": ["./packages/webhooks/src/index.ts"],
      "@opsninja/webhooks/*": ["./packages/webhooks/src/*"],
      "@opsninja/filter-compiler": ["./packages/filter-compiler/src/index.ts"],
      "@opsninja/filter-compiler/*": ["./packages/filter-compiler/src/*"],
      "@opsninja/observability": ["./packages/observability/src/index.ts"],
      "@opsninja/observability/*": ["./packages/observability/src/*"],
      "@opsninja/crypto": ["./packages/crypto/src/index.ts"],
      "@opsninja/crypto/*": ["./packages/crypto/src/*"],
      "@opsninja/test-seed": ["./packages/test-seed/src/index.ts"],
      "@opsninja/test-seed/*": ["./packages/test-seed/src/*"],
      "@opsninja/events": ["./packages/events/src/index.ts"],
      "@opsninja/events/*": ["./packages/events/src/*"]
    }
  }
}
